{
  "name": "@webship.co/workspace-rag",
  "version": "1.0.13",
  "description": "The RAG workspace for Webship Workspace: the `rag/` folder (type sites), its settings file, its 5 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin; the index builder `cmd-tools-ragify.sh`, placed in every sites and code folder; and the RAG menu on every project row (the index's state, build or rebuild in a screen, search, describe, remove, the RAG workspace).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-rag.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "rag",
    "label": "RAG",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "suggests": {
      "plugins": [
        [
          "dev",
          "test",
          "sandboxes",
          "demos",
          "projects",
          "products",
          "drupal-modules",
          "drupal-themes",
          "drupal-recipes",
          "drupal-profiles",
          "drupal-site-templates",
          "libraries"
        ]
      ],
      "commands": [
        {
          "command": "uv",
          "hint": "https://docs.astral.sh/uv/getting-started/installation/",
          "for": "cmd-tools-ragify.sh, which runs the indexer with uv run"
        }
      ]
    },
    "workspace": {
      "key": "rag",
      "settingsTemplate": "config/workspace.rag.settings.yml",
      "files": [
        "commands/cmd-milvus-backup.sh",
        "commands/cmd-milvus-mcp.sh",
        "commands/cmd-milvus-project.sh",
        "commands/cmd-tools-rag.sh",
        "commands/cmd-tools-reclaim.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/rag-index-keeper.md"
      ],
      "skills": [
        "ai/skills/rag-workflow"
      ],
      "commands": [
        "ai/commands/rag-search.md"
      ],
      "prompts": [
        "ai/prompts/rag-start-and-search.md"
      ]
    },
    "features": [
      "features/rag.feature"
    ],
    "typeActions": {
      "ragify": [
        "sites",
        "code"
      ]
    },
    "commands": {
      "types": [
        "sites",
        "code"
      ],
      "files": [
        "commands/cmd-tools-ragify.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-rag-builder.sh"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
